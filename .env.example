# Скопируйте в .env и поменяйте значения. Файл .env в git не коммитится.

# production -> JSON-логи и запрет дефолтного SECRET_KEY
ENVIRONMENT=development
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kwork
ACCESS_TOKEN_EXPIRE_MINUTES=30
MODEL_PATH=artifacts/price_model.joblib

# Используются только docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kwork
